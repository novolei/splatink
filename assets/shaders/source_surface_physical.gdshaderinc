// Source lights_physical_fragment + INK_LIGHTS, with original filtered IBL.
vec3 geometry_normal=normalize(mat3(VIEW_MATRIX)*world_normal);
vec3 geometry_derivative=max(abs(dFdx(geometry_normal)),abs(dFdy(geometry_normal)));
float geometry_roughness=max(geometry_derivative.x,max(geometry_derivative.y,geometry_derivative.z));
ROUGHNESS=min(max(ROUGHNESS,0.0525)+geometry_roughness,1.0);
vec3 cdu=dFdx(NORMAL),cdv=dFdy(NORMAL);
float kern=min(0.3*(dot(cdu,cdu)+dot(cdv,cdv)),0.18);
float cr=mix(mix(0.06,0.028,gFresh),0.022,gWake);
CLEARCOAT=gInk;CLEARCOAT_ROUGHNESS=min(sqrt(sqrt(cr*cr*cr*cr+kern)),1.0);
ROUGHNESS=mix(ROUGHNESS,min(sqrt(sqrt(pow(ROUGHNESS,4.0)+kern)),1.0),gInk);
float nv=clamp(dot(normalize(NORMAL),normalize(VIEW)),0.0,1.0);
vec2 fab=native_dfg(vec2(ROUGHNESS,nv));
vec3 dielectric=vec3(0.04)*(1.0-0.7*gInk);
vec3 f0=mix(vec3(0.04),ALBEDO,METALLIC)*(1.0-0.7*gInk);
float f90=mix(1.0,0.35,gInk),coat_f0=mix(0.04,0.055+0.015*gFresh,gInk),coat_f90=mix(1.0,0.3,gInk);
surface_specular=vec4(f0,f90);surface_coat=vec4(gInk,CLEARCOAT_ROUGHNESS,coat_f0,coat_f90);
surface_energy=vec3(1.0)+f0*(1.0/max(fab.x+fab.y,0.000001)-1.0);
surface_ink=vec4(gInkCol,gInk);surface_ao=ao;
vec3 coat_mask=vec3(1.0)-gInk*native_schlick(vec3(coat_f0),coat_f90,nv);
vec3 world_n=normalize((INV_VIEW_MATRIX*vec4(NORMAL,0.0)).xyz);
vec3 world_v=normalize((INV_VIEW_MATRIX*vec4(VIEW,0.0)).xyz);
vec3 hemi=mix(hemi_ground,hemi_sky,clamp(world_n.y*0.5+0.5,0.0,1.0));
vec3 irradiance=source_ibl_irradiance(world_n)/PI;
vec3 lw=vec3(0.2126,0.7152,0.0722);
hemi=mix(hemi,vec3(dot(hemi,lw)),0.7*gInk);
irradiance=mix(irradiance,vec3(dot(irradiance,lw)),0.7*gInk);
vec3 single_dielectric=dielectric*fab.x+vec3(f90*fab.y);
vec3 multi_dielectric=native_multi_scatter(fab,dielectric,f90);
vec3 single_metal=ALBEDO*fab.x+vec3(f90*fab.y);
vec3 multi_metal=native_multi_scatter(fab,ALBEDO,f90);
surface_indirect=ALBEDO*(1.0-METALLIC)*(hemi+irradiance)*(vec3(1.0)-single_dielectric-multi_dielectric);
vec3 indirect_specular=source_ibl_radiance(world_n,world_v,ROUGHNESS)*mix(single_dielectric,single_metal,METALLIC);
indirect_specular+=irradiance*mix(multi_dielectric,multi_metal,METALLIC);
vec3 coat_radiance=source_ibl_radiance(world_n,world_v,CLEARCOAT_ROUGHNESS);
float coat_luma=dot(coat_radiance,lw);
vec3 pigment_tint=gInkCol/max(dot(gInkCol,lw),0.001);
coat_radiance=mix(coat_radiance,mix(vec3(coat_luma),coat_luma*min(pigment_tint,vec3(2.5)),0.3),0.6*gInk);
coat_radiance*=1.0+gInk*(0.25+0.3*gFresh)+gWake*0.7;
vec2 coat_fab=native_dfg(vec2(CLEARCOAT_ROUGHNESS,nv));
vec3 coat_light=gInk*coat_radiance*(vec3(coat_f0)*coat_fab.x+vec3(coat_f90*coat_fab.y));
vec3 lamp_diffuse;
vec3 lamp_light=source_lamp_radiance(world_pos,mat3(VIEW_MATRIX),NORMAL,VIEW,ALBEDO,METALLIC,ROUGHNESS,gInk,gFresh,CLEARCOAT_ROUGHNESS,ao,lamp_diffuse);
surface_lamp_diffuse=lamp_diffuse;
EMISSION=(gInkCol*gInk*0.06*(0.75+0.35*gInkS)+surface_indirect*ao+indirect_specular*mix(1.0,ao,0.85))*coat_mask+coat_light+lamp_light;
