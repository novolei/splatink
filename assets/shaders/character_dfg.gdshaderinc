vec2 native_dfg(vec2 uv){vec2 p=clamp(uv*16.0-0.5,vec2(0.0),vec2(15.0));ivec2 a=ivec2(floor(p));ivec2 b=min(a+ivec2(1),ivec2(15));vec2 f=fract(p);return mix(mix(SOURCE_DFG[a.y*16+a.x],SOURCE_DFG[a.y*16+b.x],f.x),mix(SOURCE_DFG[b.y*16+a.x],SOURCE_DFG[b.y*16+b.x],f.x),f.y);}
